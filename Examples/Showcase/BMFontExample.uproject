{
	"FileVersion": 3,
	"DisableEnginePluginsByDefault": true,
	"Modules": [{ "Name": "BMFontExample", "Type": "Runtime", "LoadingPhase": "Default" }],
	"Plugins": [
		{ "Name": "UnrealBMFont", "Enabled": true },
		{ "Name": "ContentBrowserAssetDataSource", "Enabled": true, "TargetAllowList": ["Editor"] },
		{ "Name": "EngineAssetDefinitions", "Enabled": true, "TargetAllowList": ["Editor"] },
		{ "Name": "PythonScriptPlugin", "Enabled": true, "TargetAllowList": ["Editor"] },
		{ "Name": "EditorScriptingUtilities", "Enabled": true, "TargetAllowList": ["Editor"] }
	]
}
